# Allow-list: ignore everything by default
*
!.gitignore
!LICENSE
!README.md
!DESIGN.md
!brand/
!brand/**
!CHANGELOG.adoc
!AGENTS.md
!Cargo.toml
!Cargo.lock
!crates/
!crates/**
!docs/
!docs/**
!examples/
!examples/**
!changelog-details/
!changelog-details/**
!site/
!site/**
!supplemental-ui/
!supplemental-ui/**
!antora-playbook.yml
!.github/
!.github/**
!*.local.json5
!AI-LOCAL-LIBRARY-DOCS.local.json5

# Still exclude build/cache artifacts under allowed trees
node_modules/
**/node_modules/
package-lock.json
target/
**/target/
*.db
*.db-journal
docs/gdrive-odt/**/*.tmp
site/node_modules/
site/.output/
site/.vinxi/
site/.solid/
site/public/docs/
site/public/manual/
site/dist/
**/.DS_Store
**/Thumbs.db
