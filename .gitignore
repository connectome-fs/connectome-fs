# Allow-list: ignore everything by default
*
!.gitignore
!LICENSE
!README.md
!diagrams/
!diagrams/**
!CHANGELOG.adoc
!AGENTS.md
!package.json
!pnpm-lock.yaml
!scripts/
!scripts/**
!Cargo.toml
!Cargo.lock
!crates/
!crates/**
!docs/
!docs/**
!examples/
!examples/**
!changelog-details/
!changelog-details/**
!.github/
!.github/**
!*.local.json5
!AI-LOCAL-LIBRARY-DOCS.local.json5

# Still exclude build/cache artifacts under allowed trees
node_modules/
**/node_modules/
package-lock.json
target/
**/target/
*.db
*.db-journal
docs/gdrive-odt/**/*.tmp
**/.DS_Store
**/Thumbs.db
**/*.raw.svg
